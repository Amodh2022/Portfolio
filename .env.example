# Contact form (https://resend.com). Without a key the form tells visitors to use the email link.
RESEND_API_KEY=
# Where messages are delivered (defaults to PROFILE.email in lib/data.ts)
CONTACT_TO_EMAIL=
# Sender. The default only works for the Resend account owner until you verify a domain.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
